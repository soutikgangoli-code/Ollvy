# Ollvy Customer Portal Environment Variables
# Copy this file to .env.local and fill in the values

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXX
# Canonical public app URL used for OAuth callback construction.
# Example: https://www.ollvy.com (no trailing slash)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Google Tag Manager (for analytics and conversion tracking)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Resend (transactional email - customer-facing emails from server actions)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Slack incoming webhook URLs - one per channel. Add the same 5 vars to
# Supabase edge function secrets (Dashboard -> Project Settings -> Edge Functions).
SLACK_WEBHOOK_PAYMENTS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_OPS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_ERRORS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_LEADS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_DAILY_SUMMARY=https://hooks.slack.com/services/XXX/YYY/ZZZ
